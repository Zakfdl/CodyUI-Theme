{%- comment -%}
  CodyUI Fashion — Slide-Out Editorial Cart Drawer (cart-drawer.liquid)
{%- endcomment -%}
<cody-drawer id="CodyCartDrawer" class="cody-drawer" aria-hidden="true">
  <div class="cody-drawer__backdrop" data-drawer-close></div>
  <div
    id="CodyCartDrawerContent"
    class="cody-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.cart.title' | t }}"
  >
    <div class="cody-drawer__header">
      <h2 class="cody-drawer__title">
        {{ 'sections.cart.title' | t }}
        {%- if cart.item_count > 0 -%}
          <span class="cody-text-muted" style="font-size: 1.5rem;">({{ cart.item_count }})</span>
        {%- endif -%}
      </h2>
      <button type="button" class="cody-drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'cody-icons', icon: 'close', size: 20 %}
      </button>
    </div>

    {%- if settings.cart_enable_free_shipping_bar -%}
      {%- liquid
        assign threshold_cents = settings.cart_free_shipping_threshold | default: 200 | times: 100
        assign cart_total = cart.total_price
        if cart_total >= threshold_cents
          assign progress_pct = 100
          assign unlocked = true
        else
          assign remaining_cents = threshold_cents | minus: cart_total
          assign remaining_money = remaining_cents | money
          assign progress_pct = cart_total | times: 100.0 | divided_by: threshold_cents | round
          assign unlocked = false
        endif
      -%}
      <div class="cody-shipping-bar{% if unlocked %} cody-shipping-bar--unlocked{% endif %}">
        <div class="cody-shipping-bar__text">
          {% render 'cody-icons', icon: 'truck', size: 17 %}
          <span>
            {%- if unlocked -%}
              {{ 'general.cart.free_shipping_unlocked_html' | t }}
            {%- else -%}
              {{ 'general.cart.free_shipping_spend_more_html' | t: amount: remaining_money }}
            {%- endif -%}
          </span>
        </div>
        <div class="cody-shipping-bar__track">
          <div class="cody-shipping-bar__fill" style="width: {{ progress_pct }}%;"></div>
        </div>
      </div>
    {%- endif -%}

    {%- if cart == empty -%}
      <div class="cody-drawer__body" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
        <p class="cody-h3" style="margin-bottom: 2.4rem;">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="cody-btn cody-btn--primary" data-drawer-close>
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <div class="cody-drawer__body">
        <div class="cody-cart-items">
          {%- for item in cart.items -%}
            <div class="cody-cart-item" data-cart-line-item="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cody-media cody-media--portrait">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 240 }}"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="120"
                    height="160"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cody-cart-item__details">
                <div>
                  {%- if settings.card_show_vendor and item.product.vendor != blank -%}
                    <span class="cody-cart-item__vendor">{{ item.product.vendor }}</span>
                  {%- endif -%}
                  <div class="cody-cart-item__top">
                    <h3 class="cody-cart-item__title">
                      <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                    </h3>
                    <strong>{{ item.final_line_price | money }}</strong>
                  </div>

                  {%- unless item.product.has_only_default_variant -%}
                    <div class="cody-cart-item__options">
                      {%- for option in item.options_with_values -%}
                        <span>{{ option.name }}: {{ option.value }}</span>{% unless forloop.last %} / {% endunless %}
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}
                </div>

                <div class="cody-cart-item__bottom">
                  <cody-quantity-input class="cody-quantity" style="height: 3.6rem;">
                    <button type="button" name="minus" class="cody-quantity__btn" style="width: 3.2rem;" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title }}">
                      {% render 'cody-icons', icon: 'minus', size: 12 %}
                    </button>
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="cody-quantity__input"
                      style="width: 3.4rem; font-size: 1.3rem;"
                      data-cart-quantity-line="{{ forloop.index }}"
                      aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title }}"
                    >
                    <button type="button" name="plus" class="cody-quantity__btn" style="width: 3.2rem;" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title }}">
                      {% render 'cody-icons', icon: 'plus', size: 12 %}
                    </button>
                  </cody-quantity-input>

                  <button
                    type="button"
                    class="cody-cart-item__remove"
                    data-cart-remove-line="{{ forloop.index }}"
                    aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                  >
                    {{ 'sections.cart.remove_title' | t: title: '' }}
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if settings.cart_show_upsells -%}
          {%- assign upsell_col = settings.cart_upsell_collection | default: collections['all'] -%}
          {%- if upsell_col != blank and upsell_col.products_count > 0 -%}
            <div class="cody-cart-upsells">
              <h3 class="cody-cart-upsells__heading">{{ 'general.cart.upsell_heading' | t }}</h3>
              <div class="cody-cart-upsells__list">
                {%- for upsell_product in upsell_col.products limit: 4 -%}
                  {%- if upsell_product.available -%}
                    <div class="cody-cart-upsell-card">
                      <a href="{{ upsell_product.url }}" class="cody-media cody-media--portrait">
                        {%- if upsell_product.featured_media != blank -%}
                          <img
                            src="{{ upsell_product.featured_media | image_url: width: 160 }}"
                            alt="{{ upsell_product.title | escape }}"
                            width="80"
                            height="106"
                            loading="lazy"
                          >
                        {%- endif -%}
                      </a>
                      <div>
                        <h4 style="font-size: 1.3rem; font-family: var(--cody-font-body-family); margin: 0 0 0.4rem;">
                          <a href="{{ upsell_product.url }}">{{ upsell_product.title | truncate: 28 }}</a>
                        </h4>
                        <div style="font-size: 1.25rem; margin-bottom: 0.8rem;">{{ upsell_product.price | money }}</div>
                        <button
                          type="button"
                          class="cody-btn cody-btn--outline cody-btn--sm"
                          style="min-height: 3rem; padding: 0.5rem 1.2rem; font-size: 1rem;"
                          data-quick-add-variant="{{ upsell_product.selected_or_first_available_variant.id }}"
                        >
                          + {{ 'products.product.quick_add' | t }}
                        </button>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="cody-drawer__footer">
        <div class="cody-cart-extras">
          {%- if settings.cart_show_gift_wrap -%}
            <label class="cody-cart-giftwrap">
              <input
                type="checkbox"
                data-cart-giftwrap-toggle
                {% if cart.attributes['Luxury Gift Box'] == 'Yes' %}checked{% endif %}
              >
              {% render 'cody-icons', icon: 'gift', size: 16 %}
              <span>{{ 'general.cart.gift_wrap_label' | t: price: settings.cart_gift_wrap_price_display }}</span>
            </label>
          {%- endif -%}

          {%- if settings.cart_show_note -%}
            <details>
              <summary style="font-size: 1.2rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer;">
                + {{ 'general.cart.order_note_label' | t }}
              </summary>
              <textarea
                name="note"
                class="cody-textarea"
                style="min-height: 7.2rem; margin-top: 0.8rem;"
                placeholder="{{ 'general.cart.order_note_placeholder' | t }}"
                data-cart-note-input
              >{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          {%- if settings.cart_show_discount_input -%}
            <div style="display: flex; gap: 0.8rem;">
              <input
                type="text"
                id="CodyCartDiscountInput"
                class="cody-input"
                style="min-height: 4rem; padding: 0.8rem 1.2rem; font-size: 1.25rem;"
                placeholder="{{ 'general.cart.discount_code_placeholder' | t }}"
              >
              <button type="button" class="cody-btn cody-btn--outline cody-btn--sm" data-cart-discount-apply>
                {{ 'general.cart.discount_apply' | t }}
              </button>
            </div>
          {%- endif -%}
        </div>

        <div class="cody-cart-subtotal">
          <span class="cody-cart-subtotal__label">{{ 'sections.cart.subtotal' | t }}</span>
          <span class="cody-cart-subtotal__value">{{ cart.total_price | money_with_currency }}</span>
        </div>

        <p class="cody-cart-tax-note">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

        <form action="{{ routes.cart_url }}" method="post" id="CodyCartDrawerCheckoutForm">
          <div style="display: grid; grid-template-columns: 1fr 1.4fr; gap: 1rem;">
            <a href="{{ routes.cart_url }}" class="cody-btn cody-btn--outline cody-btn--full">
              {{ 'sections.quick_order_list.view_cart' | t }}
            </a>
            <button type="submit" name="checkout" class="cody-btn cody-btn--primary cody-btn--full">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </div>
        </form>
      </div>
    {%- endif -%}
  </div>
</cody-drawer>

{% schema %}
{
  "name": "Slide-Out Cart Drawer",
  "settings": []
}
{% endschema %}
