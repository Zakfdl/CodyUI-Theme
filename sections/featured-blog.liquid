<section class="cody-section color-{{ section.settings.color_scheme }}">
  <div class="cody-container">
    <div class="cody-section-header">
      <div>
        <span class="cody-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="cody-h1" style="margin-bottom: 0;">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.blog != blank -%}
        <a href="{{ section.settings.blog.url }}" class="cody-link-editorial">
          <span>{{ 'sections.featured_blog.view_all' | t }}</span>
          {% render 'cody-icons', icon: 'arrow-right', size: 15 %}
        </a>
      {%- endif -%}
    </div>

    <div class="cody-grid cody-grid--3">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
          <article class="cody-card">
            <a href="{{ article.url }}" class="cody-card__media-wrap cody-media cody-media--landscape">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 900 }}"
                  alt="{{ article.title | escape }}"
                  class="cody-card__img--primary"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
            <div class="cody-card__info" style="padding-top: 1.8rem;">
              <span class="cody-eyebrow" style="margin-bottom: 0.4rem;">{{ article.published_at | time_tag: format: 'date' }}</span>
              <h3 class="cody-h3" style="margin-bottom: 0.8rem;"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              <p class="cody-text-muted" style="margin: 0 0 1.4rem;">
                {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
              </p>
              <a href="{{ article.url }}" class="cody-link-editorial">
                <span>{{ 'blogs.article.read_more' | t }}</span>
                {% render 'cody-icons', icon: 'arrow-right', size: 14 %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- liquid
          assign blog_imgs = 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=900&q=80|https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&w=900&q=80' | split: '|'
          assign blog_titles = 'Inside the Milan Atelier: Architectural Cashmere|The Art of the Capsule Wardrobe: 12 Timeless Pieces|Runway Notes: Quiet Luxury & Monochromatic Tailoring' | split: '|'
          assign blog_dates = 'OCTOBER 24, 2026|OCTOBER 12, 2026|SEPTEMBER 28, 2026' | split: '|'
          assign blog_excerpts = 'Exploring how our master tailors source un-dyed Mongolian cashmere and sculpt fluid, unlined silhouettes built to last decades.|How to build a cohesive seasonal rotation anchored by Italian virgin wool outerwear, crisp organic poplin, and structured leather.|Backstage notes from our Autumn/Winter presentation on proportion, tactile drape, and understated hardware.' | split: '|'
        -%}
        {%- for i in (0..2) -%}
          <article class="cody-card">
            <a href="{{ routes.all_products_collection_url }}" class="cody-card__media-wrap cody-media cody-media--landscape">
              <img
                src="{{ blog_imgs[i] }}"
                alt="{{ blog_titles[i] | escape }}"
                class="cody-card__img--primary"
                width="900"
                height="600"
                loading="lazy"
              >
            </a>
            <div class="cody-card__info" style="padding-top: 1.8rem;">
              <span class="cody-eyebrow" style="margin-bottom: 0.4rem;">{{ blog_dates[i] }}</span>
              <h3 class="cody-h3" style="margin-bottom: 0.8rem;"><a href="{{ routes.all_products_collection_url }}">{{ blog_titles[i] }}</a></h3>
              <p class="cody-text-muted" style="margin: 0 0 1.4rem;">{{ blog_excerpts[i] }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="cody-link-editorial">
                <span>{{ 'blogs.article.read_more' | t }}</span>
                {% render 'cody-icons', icon: 'arrow-right', size: 14 %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Journal Posts",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "THE ATELIER JOURNAL",
      "label": "Eyebrow subtitle"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Stories, Craft & Runway Notes",
      "label": "Heading"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Articles to show"
    }
  ],
  "presets": [
    {
      "name": "Editorial Journal Posts"
    }
  ]
}
{% endschema %}
