<section class="cody-section color-{{ section.settings.color_scheme }}">
  <div class="cody-container">
    <div class="cody-section-header">
      <h1 class="cody-h1" style="margin-bottom: 0;">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="cody-link-editorial">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>

    {%- if cart == empty -%}
      <div style="text-align: center; padding: 6rem 2rem;">
        <p class="cody-h3" style="margin-bottom: 2.4rem;">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="cody-btn cody-btn--primary">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <table class="cody-cart-table">
          <thead>
            <tr>
              <th colspan="2">{{ 'sections.cart.headings.product' | t }}</th>
              <th>{{ 'sections.cart.headings.quantity' | t }}</th>
              <th style="text-align: right;">{{ 'sections.cart.headings.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td style="width: 11rem; padding-right: 2rem;">
                  <a href="{{ item.url }}" class="cody-media cody-media--portrait">
                    {%- if item.image -%}
                      <img
                        src="{{ item.image | image_url: width: 240 }}"
                        alt="{{ item.image.alt | escape }}"
                        width="110"
                        height="146"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </a>
                </td>
                <td>
                  {%- if settings.card_show_vendor -%}
                    <span class="cody-cart-item__vendor">{{ item.product.vendor }}</span>
                  {%- endif -%}
                  <h3 class="cody-cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
                  <div style="margin-top: 0.4rem;">{{ item.final_price | money }}</div>
                  {%- unless item.product.has_only_default_variant -%}
                    <div class="cody-cart-item__options">
                      {%- for option in item.options_with_values -%}
                        <span>{{ option.name }}: {{ option.value }}</span>{% unless forloop.last %} / {% endunless %}
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}
                </td>
                <td>
                  <div style="display: flex; align-items: center; gap: 1.6rem;">
                    <cody-quantity-input class="cody-quantity">
                      <button type="button" name="minus" class="cody-quantity__btn">
                        {% render 'cody-icons', icon: 'minus', size: 14 %}
                      </button>
                      <input
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        class="cody-quantity__input"
                        data-cart-quantity-line="{{ forloop.index }}"
                      >
                      <button type="button" name="plus" class="cody-quantity__btn">
                        {% render 'cody-icons', icon: 'plus', size: 14 %}
                      </button>
                    </cody-quantity-input>
                    <button
                      type="button"
                      class="cody-cart-item__remove"
                      data-cart-remove-line="{{ forloop.index }}"
                    >
                      {% render 'cody-icons', icon: 'trash', size: 16 %}
                    </button>
                  </div>
                </td>
                <td style="text-align: right; font-weight: 600;">
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart Items",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
