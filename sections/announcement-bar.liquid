{{ 'header.css' | asset_url | stylesheet_tag }}

<div
  class="cody-announcement color-{{ section.settings.color_scheme }}"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  style="--cody-marquee-speed: {{ section.settings.marquee_speed }}s;"
>
  <div class="cody-container{% if section.settings.full_width %} cody-container--fluid{% endif %}">
    <div class="cody-announcement__inner">
      {%- if section.settings.show_utility_links and section.settings.display_mode != 'marquee' -%}
        <div class="cody-announcement__utility-links">
          {%- if section.settings.utility_label_1 != blank -%}
            <a href="{{ section.settings.utility_link_1 | default: routes.collections_url }}" class="cody-announcement__utility-link">
              {{ section.settings.utility_label_1 | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.utility_label_2 != blank -%}
            <a href="{{ section.settings.utility_link_2 | default: routes.all_products_collection_url }}" class="cody-announcement__utility-link">
              {{ section.settings.utility_label_2 | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="cody-announcement__center">
        {%- if section.blocks.size > 0 -%}
          {%- if section.settings.display_mode == 'marquee' -%}
            <div class="cody-marquee" aria-label="{{ 'sections.header.announcement' | t }}">
              {%- for i in (1..2) -%}
                <div class="cody-marquee__track" {% if i == 2 %}aria-hidden="true"{% endif %}>
                  {%- for block in section.blocks -%}
                    <div class="cody-announcement__message" {{ block.shopify_attributes }}>
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if block.settings.countdown_date != blank -%}
                        <span class="cody-countdown-inline" data-cody-countdown="{{ block.settings.countdown_date | escape }}">
                          00d : 00h : 00m : 00s
                        </span>
                      {%- endif -%}
                      {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                        <a href="{{ block.settings.link }}" class="cody-announcement__link">
                          {{ block.settings.link_label | escape }}
                        </a>
                      {%- endif -%}
                      <span aria-hidden="true">&bull;</span>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            {%- assign first_block = section.blocks.first -%}
            <div class="cody-announcement__message" {{ first_block.shopify_attributes }}>
              <span>{{ first_block.settings.text | escape }}</span>
              {%- if first_block.settings.countdown_date != blank -%}
                <span class="cody-countdown-inline" data-cody-countdown="{{ first_block.settings.countdown_date | escape }}">
                  00d : 00h : 00m : 00s
                </span>
              {%- endif -%}
              {%- if first_block.settings.link != blank and first_block.settings.link_label != blank -%}
                <a href="{{ first_block.settings.link }}" class="cody-announcement__link">
                  {{ first_block.settings.link_label | escape }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="cody-announcement__message">
            <span>COMPLIMENTARY DHL EXPRESS SHIPPING &amp; SIGNATURE GARMENT BOX ON ORDERS OVER $250</span>
            <a href="{{ routes.all_products_collection_url }}" class="cody-announcement__link">EXPLORE RUNWAY</a>
          </div>
        {%- endif -%}
      </div>

        {%- if section.settings.show_localization and section.settings.display_mode != 'marquee' -%}
          <div class="cody-announcement__localization">
            {%- if localization.available_countries.size > 1 -%}
              <cody-localization-form>
                {%- form 'localization', id: 'AnnouncementCountryForm', class: 'cody-localization-form' -%}
                  <label class="visually-hidden" for="AnnouncementCountrySelect">{{ 'localization.country_label' | t }}</label>
                  <select id="AnnouncementCountrySelect" name="country_code" class="cody-loc-select">
                    {%- for country in localization.available_countries -%}
                      <option
                        value="{{ country.iso_code }}"
                        {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                      >
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </option>
                    {%- endfor -%}
                  </select>
                {%- endform -%}
              </cody-localization-form>
            {%- endif -%}

            {%- if localization.available_languages.size > 1 -%}
              <cody-localization-form>
                {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'cody-localization-form' -%}
                  <label class="visually-hidden" for="AnnouncementLanguageSelect">{{ 'localization.language_label' | t }}</label>
                  <select id="AnnouncementLanguageSelect" name="locale_code" class="cody-loc-select">
                    {%- for language in localization.available_languages -%}
                      <option
                        value="{{ language.iso_code }}"
                        {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                      >
                        {{ language.endonym_name | capitalize }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- endform -%}
              </cody-localization-form>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script>
    (function () {
      const countdowns = document.querySelectorAll('[data-cody-countdown]');
      if (!countdowns.length) return;
      function updateCountdowns() {
        const now = Date.now();
        countdowns.forEach((el) => {
          const target = Date.parse(el.dataset.codyCountdown);
          if (isNaN(target)) return;
          const diff = Math.max(0, target - now);
          const d = Math.floor(diff / (1000 * 60 * 60 * 24));
          const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
          const m = Math.floor((diff / 1000 / 60) % 60);
          const s = Math.floor((diff / 1000) % 60);
          el.textContent = `${String(d).padStart(2, '0')}d : ${String(h).padStart(2, '0')}h : ${String(m).padStart(2, '0')}m : ${String(s).padStart(2, '0')}s`;
        });
      }
      updateCountdowns();
      setInterval(updateCountdowns, 1000);
    })();
  </script>

{% schema %}
{
  "name": "Announcement & Ticker Bar",
  "max_blocks": 8,
  "class": "cody-section-announcement",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Announcement display mode",
      "options": [
        { "value": "static", "label": "Centered Editorial Bar" },
        { "value": "marquee", "label": "Continuous Scrolling Runway Marquee" }
      ],
      "default": "static"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "s",
      "label": "Marquee scroll speed",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full-bleed container width",
      "default": true
    },
    {
      "type": "header",
      "content": "Left Utility Links (Static Mode)"
    },
    {
      "type": "checkbox",
      "id": "show_utility_links",
      "label": "Show left utility links on desktop",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_label_1",
      "label": "Utility link 1 label",
      "default": "Boutique Locator"
    },
    {
      "type": "url",
      "id": "utility_link_1",
      "label": "Utility link 1 URL"
    },
    {
      "type": "text",
      "id": "utility_label_2",
      "label": "Utility link 2 label",
      "default": "Client Concierge"
    },
    {
      "type": "url",
      "id": "utility_link_2",
      "label": "Utility link 2 URL"
    },
    {
      "type": "header",
      "content": "Currency & Language Selectors"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country and language selectors",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement message",
          "default": "Complimentary Express Shipping & Luxury Packaging on Orders Over $200"
        },
        {
          "type": "text",
          "id": "countdown_date",
          "label": "Optional Countdown End Date (ISO format)",
          "info": "Example: 2026-12-31T23:59:59. Leave blank to hide timer."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Call-to-action link label",
          "default": "Discover Autumn/Winter"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Call-to-action URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement & Ticker Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Complimentary Express Shipping & Signature Gift Box on Orders Over $200",
            "link_label": "Explore Collection"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Autumn / Winter Runway Capsule Now Live Online & In Boutiques",
            "link_label": "Shop Runway"
          }
        }
      ]
    }
  ]
}
{% endschema %}
