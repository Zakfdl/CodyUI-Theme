<section class="cody-section color-{{ section.settings.color_scheme }}">
  <div class="cody-container cody-container--narrow">
    <div class="cody-section-header">
      <div>
        <span class="cody-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="cody-h1" style="margin-bottom: 0;">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    {%- form 'contact', id: 'ContactForm', class: 'cody-contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p style="color: var(--cody-color-success); margin-bottom: 2.4rem;">
          {{ 'templates.contact.form.post_success' | t }}
        </p>
      {%- elseif form.errors -%}
        <div style="color: var(--cody-color-sale); margin-bottom: 2.4rem;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr)); gap: 2rem; margin-bottom: 2rem;">
        <div class="cody-field">
          <label class="cody-label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
          <input class="cody-input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="cody-field">
          <label class="cody-label" for="ContactForm-email">{{ 'templates.contact.form.email' | t }} *</label>
          <input class="cody-input" autocomplete="email" type="email" id="ContactForm-email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
        </div>
      </div>

      <div class="cody-field" style="margin-bottom: 2rem;">
        <label class="cody-label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
        <input type="tel" id="ContactForm-phone" class="cody-input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
      </div>

      <div class="cody-field" style="margin-bottom: 2.4rem;">
        <label class="cody-label" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
        <textarea rows="6" id="ContactForm-body" class="cody-textarea" name="contact[{{ 'templates.contact.form.comment' | t }}]">{{- form.body -}}</textarea>
      </div>

      <button type="submit" class="cody-btn cody-btn--primary cody-btn--lg">
        {{ 'templates.contact.form.send' | t }}
      </button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Client Concierge Contact",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "CLIENT CONCIERGE",
      "label": "Eyebrow subtitle"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Private Styling & Inquiries",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "Client Concierge Contact"
    }
  ]
}
{% endschema %}
