<section class="cody-section color-{{ section.settings.color_scheme }}" style="min-height: 100vh; display: flex; align-items: center; text-align: center;">
  <div class="cody-container cody-container--narrow">
    <span class="cody-eyebrow">{{ shop.name }}</span>
    <h1 class="cody-display-lg">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="cody-text-muted" style="margin-bottom: 3.2rem;">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'cody-password-form' -%}
      {%- if form.errors -%}
        <p style="color: var(--cody-color-sale); margin-bottom: 1.6rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div style="max-width: 44rem; margin-inline: auto; display: flex; gap: 1rem;">
        <input
          type="password"
          name="password"
          id="Password"
          class="cody-input"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          required
        >
        <button type="submit" name="commit" class="cody-btn cody-btn--primary">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password Drop Access",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Private Capsule Drop — Enter Access Code",
      "label": "Heading"
    }
  ]
}
{% endschema %}
