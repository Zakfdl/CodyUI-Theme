{%- if settings.enable_recently_viewed -%}
  <section id="CodyRecentlyViewedSection-{{ section.id }}" class="cody-section color-{{ section.settings.color_scheme }}" hidden>
    <div class="cody-container">
      <div class="cody-section-header">
        <div>
          <span class="cody-eyebrow">{{ section.settings.eyebrow | escape }}</span>
          <h2 class="cody-h2" style="margin-bottom: 0;">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>

      <div id="CodyRecentlyViewedGrid-{{ section.id }}" class="cody-grid cody-grid--{{ section.settings.columns_desktop }}"></div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sectionWrap = document.getElementById('CodyRecentlyViewedSection-{{ section.id }}');
      const grid = document.getElementById('CodyRecentlyViewedGrid-{{ section.id }}');
      if (!sectionWrap || !grid || !window.CodyStore) return;

      const currentHandle = {{ product.handle | json }};
      const handles = window.CodyStore
        .getList(window.CodyStore.recentlyViewedKey)
        .filter((h) => h && h !== currentHandle)
        .slice(0, {{ section.settings.products_to_show | default: 4 }});

      if (!handles.length) return;

      Promise.all(
        handles.map((handle) =>
          fetch(`${window.routes.root_url}products/${handle}.js`)
            .then((r) => (r.ok ? r.json() : null))
            .catch(() => null)
        )
      ).then((products) => {
        const valid = products.filter(Boolean);
        if (!valid.length) return;
        const currency = window.codyConfig?.currencySymbol || '$';

        grid.innerHTML = valid
          .map(
            (p) => `
          <article class="cody-card" data-product-card data-product-handle="${p.handle}">
            <div class="cody-card__media-wrap cody-media cody-media--portrait">
              <a href="${p.url}" class="cody-card__link-overlay">
                ${p.featured_image ? `<img src="${p.featured_image}" alt="${p.title}" loading="lazy" class="cody-card__img--primary">` : ''}
              </a>
            </div>
            <div class="cody-card__info">
              <span class="cody-card__vendor">${p.vendor || ''}</span>
              <div class="cody-card__header-row">
                <h3 class="cody-card__title"><a href="${p.url}">${p.title}</a></h3>
                <div class="cody-price">${currency}${(p.price / 100).toFixed(2)}</div>
              </div>
            </div>
          </article>
        `
          )
          .join('');
        sectionWrap.hidden = false;
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Recently Viewed Pieces",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "YOUR BROWSING HISTORY",
      "label": "Eyebrow subtitle"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Recently Viewed",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed Pieces"
    }
  ]
}
{% endschema %}
