<!doctype html>
{%- liquid
  assign rtl_locales = 'ar,he,fa,ur' | split: ','
  assign is_rtl = false
  if settings.enable_rtl or rtl_locales contains request.locale.iso_code
    assign is_rtl = true
  endif
-%}
<html
  class="no-js full-height"
  lang="{{ request.locale.iso_code }}"
  {% if is_rtl %}dir="rtl"{% else %}dir="ltr"{% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background | default: '#FAF8F5' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; {{ 'general.password_page.login_form_heading' | t }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'cody-css-vars' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="cody-body cody-password color-scheme-1">
    <a class="cody-skip-link cody-btn cody-btn--primary visually-hidden" href="#PasswordMain">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <main id="PasswordMain" class="cody-password-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
