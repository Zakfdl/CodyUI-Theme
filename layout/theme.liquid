<!doctype html>
{%- liquid
  assign rtl_locales = 'ar,he,fa,ur' | split: ','
  assign is_rtl = false
  if settings.enable_rtl or rtl_locales contains request.locale.iso_code
    assign is_rtl = true
  endif
-%}
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  {% if is_rtl %}dir="rtl"{% else %}dir="ltr"{% endif %}
  data-button-hover="{{ settings.button_hover_effect | default: 'slide-fill' }}"
  data-swatch-shape="{{ settings.swatch_shape | default: 'circle' }}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_schemes['scheme-1'].settings.background | default: '#FAF8F5' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- if settings.heading_font_source == 'shopify' or settings.body_font_source == 'shopify' -%}
      {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'cody-css-vars' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-cart.css' | asset_url | stylesheet_tag }}
    {{ 'sections-editorial.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    <script type="importmap">
      {
        "imports": {
          "@cody/constants": "{{ 'constants.js' | asset_url }}",
          "@cody/pubsub": "{{ 'pubsub.js' | asset_url }}",
          "@cody/global": "{{ 'global.js' | asset_url }}"
        }
      }
    </script>
  </head>

  <body class="cody-body color-scheme-1 template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}">
    <a class="cody-skip-link cody-btn cody-btn--primary visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: page.url | json }}
      }
    </script>

    {%- capture header_group_html -%}{% sections 'header-group' %}{%- endcapture -%}
    {%- if header_group_html contains 'cody-header' -%}
      {{ header_group_html }}
    {%- else -%}
      {%- render 'cody-header-shell' -%}
    {%- endif -%}

    <main id="MainContent" class="cody-main focus-none" role="main" tabindex="-1">
      {%- unless request.page_type == 'index' or request.page_type == 'cart' or request.page_type == 'list-collections' or request.page_type == '404' or template.name == 'index' -%}
        {%- if settings.show_breadcrumbs -%}
          {%- render 'breadcrumb' -%}
        {%- endif -%}
      {%- endunless -%}
      {{ content_for_layout }}
    </main>

    {%- capture footer_group_html -%}{% sections 'footer-group' %}{%- endcapture -%}
    {%- if footer_group_html contains 'cody-footer' -%}
      {{ footer_group_html }}
    {%- else -%}
      {%- render 'cody-footer-shell' -%}
    {%- endif -%}

    {%- comment -%} Global Quick View Modal Shell (populated via Section Rendering API) {%- endcomment -%}
    <cody-modal id="CodyQuickViewModal" class="cody-modal cody-modal--quickview" aria-hidden="true">
      <div class="cody-modal__backdrop" data-modal-close></div>
      <div class="cody-modal__dialog" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
        <button type="button" class="cody-modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t }}">
          {% render 'cody-icons', icon: 'close', size: 20 %}
        </button>
        <div class="cody-modal__content" data-quickview-container></div>
      </div>
    </cody-modal>

    {%- comment -%} Global Toast Notification Container {%- endcomment -%}
    <cody-toast-manager class="cody-toast-container" aria-live="polite" aria-atomic="true"></cody-toast-manager>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        root_url: '{{ routes.root_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
        all_products_collection_url: '{{ routes.all_products_collection_url }}',
        collections_url: '{{ routes.collections_url }}'
      };

      window.codyConfig = {
        cartType: {{ settings.cart_type | json }},
        freeShippingEnabled: {{ settings.cart_enable_free_shipping_bar | json }},
        freeShippingThreshold: {{ settings.cart_free_shipping_threshold | default: 200 | times: 100 | json }},
        currencySymbol: {{ cart.currency.symbol | json }},
        currencyCode: {{ cart.currency.iso_code | json }},
        compareMaxItems: {{ settings.compare_max_items | default: 4 | json }},
        recentlyViewedLimit: {{ settings.recently_viewed_limit | default: 8 | json }}
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      };

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailableWithOption: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`
      };

      window.wishlistStrings = {
        added: `{{ 'general.wishlist.add' | t }}`,
        removed: `{{ 'general.wishlist.remove' | t }}`,
        compareAdded: `{{ 'general.compare.add' | t }}`,
        compareRemoved: `{{ 'general.compare.remove' | t }}`
      };

      {%- if settings.external_links_new_tab -%}
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('a[href^="http"]').forEach((link) => {
            if (!link.href.includes(window.location.hostname)) {
              link.setAttribute('target', '_blank');
              link.setAttribute('rel', 'noopener noreferrer');
            }
          });
        });
      {%- endif -%}
    </script>
  </body>
</html>
