<section class="cody-section color-scheme-1">
  <div class="cody-container cody-container--narrow" style="max-width: 48rem;">
    <div style="text-align: center; margin-bottom: 3.6rem;">
      <span class="cody-eyebrow">CLIENT INVITATION</span>
      <h1 class="cody-h1" style="margin-bottom: 0;">{{ 'customer.activate_account.title' | t }}</h1>
    </div>

    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="cody-field" style="margin-bottom: 1.8rem;">
        <label class="cody-label" for="password">{{ 'customer.activate_account.password' | t }}</label>
        <input type="password" value="" name="customer[password]" id="password" class="cody-input" required>
      </div>
      <div class="cody-field" style="margin-bottom: 2.4rem;">
        <label class="cody-label" for="password_confirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input type="password" value="" name="customer[password_confirmation]" id="password_confirmation" class="cody-input" required>
      </div>
      <button type="submit" class="cody-btn cody-btn--primary cody-btn--full">
        {{ 'customer.activate_account.submit' | t }}
      </button>
    {%- endform -%}
  </div>
</section>
