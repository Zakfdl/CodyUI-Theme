<section class="cody-section color-scheme-1">
  <div class="cody-container cody-container--narrow" style="max-width: 48rem;">
    <div style="text-align: center; margin-bottom: 3.6rem;">
      <span class="cody-eyebrow">CLIENT PORTAL</span>
      <h1 class="cody-h1" style="margin-bottom: 0;">{{ 'customer.login_page.title' | t }}</h1>
    </div>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div style="color: var(--cody-color-sale); margin-bottom: 2rem;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="cody-field" style="margin-bottom: 2rem;">
        <label class="cody-label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          class="cody-input"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
      </div>

      {%- if form.password_needed -%}
        <div class="cody-field" style="margin-bottom: 2.4rem;">
          <label class="cody-label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
          <input
            type="password"
            value=""
            name="customer[password]"
            id="CustomerPassword"
            class="cody-input"
            autocomplete="current-password"
            required
          >
        </div>
      {%- endif -%}

      <button type="submit" class="cody-btn cody-btn--primary cody-btn--full" style="margin-bottom: 1.6rem;">
        {{ 'customer.login_page.sign_in' | t }}
      </button>

      <div style="text-align: center;">
        <a href="{{ routes.account_register_url }}" class="cody-link-editorial">
          {{ 'customer.login_page.create_account' | t }}
        </a>
      </div>
    {%- endform -%}
  </div>
</section>
