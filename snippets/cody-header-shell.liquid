{%- comment -%}
  CodyUI Fashion — Global Storefront Header & 5-Column Mega Menu Shell
  Rendered directly in layout/theme.liquid so the Announcement Bar, Split Luxury Header,
  5-Column Mega Menu, Mobile Off-Canvas Drawer, and Predictive Search Drawer are 100%
  guaranteed to render on every store without any section-sync dependency.
{%- endcomment -%}
{{ 'header.css' | asset_url | stylesheet_tag }}
{%- if settings.predictive_search_enabled -%}
  <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- assign main_menu = linklists['main-menu'] -%}

{%- comment -%} 1. Top Luxury Announcement & Concierge Bar {%- endcomment -%}
<div
  class="cody-announcement color-scheme-3"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  style="--cody-marquee-speed: 28s;"
>
  <div class="cody-container cody-container--fluid">
    <div class="cody-announcement__inner">
      <div class="cody-announcement__utility-links">
        <a href="{{ routes.collections_url }}" class="cody-announcement__utility-link">Boutique Locator</a>
        <a href="{{ routes.all_products_collection_url }}" class="cody-announcement__utility-link">Client Concierge</a>
      </div>

      <div class="cody-announcement__center">
        <div class="cody-announcement__message">
          <span>COMPLIMENTARY DHL EXPRESS SHIPPING &amp; SIGNATURE GARMENT BOX ON ORDERS OVER $250</span>
          <a href="{{ routes.all_products_collection_url }}" class="cody-announcement__link">EXPLORE RUNWAY</a>
        </div>
      </div>

      <div class="cody-announcement__localization">
        {%- if localization.available_countries.size > 1 -%}
          <cody-localization-form>
            {%- form 'localization', id: 'HeaderShellCountryForm', class: 'cody-localization-form' -%}
              <label class="visually-hidden" for="HeaderShellCountrySelect">{{ 'localization.country_label' | t }}</label>
              <select id="HeaderShellCountrySelect" name="country_code" class="cody-loc-select">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            {%- endform -%}
          </cody-localization-form>
        {%- else -%}
          <span style="font-size: 1.1rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85;">USD $ &bull; EN</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} 2. Primary Luxury Split Header + 5-Column Mega Menu {%- endcomment -%}
<div
  class="cody-header-wrapper color-scheme-1"
  data-header-wrapper
  data-sticky="on-scroll-up"
  data-transparent="false"
  style="--cody-header-height: 76px; --cody-transparent-text: #FFFFFF;"
>
  <header class="cody-header cody-header--logo-center-split">
    <div class="cody-container cody-container--fluid">
      <div class="cody-header__inner">
        {%- comment -%} Left: Mobile Drawer Toggle + Desktop Navigation & Mega Menu {%- endcomment -%}
        <div class="cody-header__left" style="display: flex; align-items: center; gap: 2.4rem;">
          <button
            type="button"
            class="cody-header__mobile-toggle"
            data-drawer-open="CodyMobileMenuDrawer"
            aria-label="{{ 'sections.header.menu' | t }}"
          >
            {% render 'cody-icons', icon: 'menu', size: 22 %}
            <span>{{ 'sections.header.menu' | t }}</span>
          </button>

          {%- render 'header-desktop-nav', main_menu: main_menu -%}
        </div>

        {%- comment -%} Center: Editorial Maison Logo {%- endcomment -%}
        <div class="cody-header__logo">
          {%- if request.page_type == 'index' -%}<h1 style="margin: 0;">{%- endif -%}
            <a href="{{ routes.root_url }}" class="cody-header__logo-link">
              <span class="cody-header__logo-text">{{ shop.name | default: 'CODYUI' }}</span>
            </a>
          {%- if request.page_type == 'index' -%}</h1>{%- endif -%}
        </div>

        {%- comment -%} Right: Utility Icons (Search, Account, Wishlist, Compare, Bag Drawer) {%- endcomment -%}
        <div class="cody-header__actions">
          <button
            type="button"
            class="cody-header__action-btn"
            data-drawer-open="CodySearchDrawer"
            aria-label="{{ 'general.search.search' | t }}"
          >
            {% render 'cody-icons', icon: 'search', size: 20 %}
          </button>

          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="cody-header__action-btn"
            aria-label="Account"
          >
            {% render 'cody-icons', icon: 'user', size: 20 %}
          </a>

          {%- if settings.enable_wishlist -%}
            <a
              href="/pages/wishlist"
              class="cody-header__action-btn"
              aria-label="{{ 'general.wishlist.title' | t }}"
            >
              {% render 'cody-icons', icon: 'heart', size: 20 %}
              <span class="cody-header__badge" data-wishlist-count hidden>0</span>
            </a>
          {%- endif -%}

          {%- if settings.enable_compare -%}
            <a
              href="/pages/compare"
              class="cody-header__action-btn"
              aria-label="{{ 'general.compare.title' | t }}"
            >
              {% render 'cody-icons', icon: 'compare', size: 20 %}
              <span class="cody-header__badge" data-compare-count hidden>0</span>
            </a>
          {%- endif -%}

          <a
            href="{{ routes.cart_url }}"
            class="cody-header__action-btn"
            id="cart-icon-bubble"
            {% if settings.cart_type == 'drawer' and template != 'cart' %}
              data-drawer-open="CodyCartDrawer"
            {% endif %}
          >
            {%- render 'cody-icons', icon: 'bag', size: 20 -%}
            <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
            {%- if cart != empty -%}
              <span class="cody-header__badge" aria-hidden="true">
                {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}99+{%- endif -%}
              </span>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>
  </header>
</div>

{%- comment -%} 3. Mobile Off-Canvas Navigation Drawer {%- endcomment -%}
<cody-drawer id="CodyMobileMenuDrawer" class="cody-drawer cody-drawer--left" aria-hidden="true">
  <div class="cody-drawer__backdrop" data-drawer-close></div>
  <div class="cody-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="cody-drawer__header">
      <span class="cody-drawer__title">{{ shop.name }}</span>
      <button type="button" class="cody-drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'cody-icons', icon: 'close', size: 20 %}
      </button>
    </div>
    <div class="cody-drawer__body">
      <ul class="cody-mobile-nav">
        {%- for link in main_menu.links -%}
          <li class="cody-mobile-nav__item">
            <a href="{{ link.url }}" class="cody-mobile-nav__link">
              <span>{{ link.title | escape }}</span>
              {% render 'cody-icons', icon: 'arrow-up-right', size: 16 %}
            </a>
          </li>
        {%- endfor -%}
        <li class="cody-mobile-nav__item">
          <a href="{{ routes.collections_url }}" class="cody-mobile-nav__link">
            <span>Collections</span>
            {% render 'cody-icons', icon: 'arrow-up-right', size: 16 %}
          </a>
        </li>
        <li class="cody-mobile-nav__item">
          <a href="{{ routes.all_products_collection_url }}" class="cody-mobile-nav__link">
            <span>Archive Sale (-30%)</span>
            {% render 'cody-icons', icon: 'arrow-up-right', size: 16 %}
          </a>
        </li>
      </ul>
    </div>
  </div>
</cody-drawer>

{%- comment -%} 4. Predictive Search Drawer {%- endcomment -%}
<cody-drawer id="CodySearchDrawer" class="cody-drawer cody-search-drawer" aria-hidden="true">
  <div class="cody-drawer__backdrop" data-drawer-close></div>
  <div class="cody-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
    <div class="cody-drawer__header">
      <span class="cody-drawer__title">{{ 'general.search.search' | t | truncatewords: 1, '' }}</span>
      <button type="button" class="cody-drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'cody-icons', icon: 'close', size: 20 %}
      </button>
    </div>
    <div class="cody-drawer__body">
      <cody-predictive-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="cody-search-form">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.search' | t }}"
            class="cody-search-form__input"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
          >
          <input name="options[prefix]" type="hidden" value="last">
          <button type="submit" class="cody-header__action-btn" aria-label="{{ 'general.search.search' | t }}">
            {% render 'cody-icons', icon: 'search', size: 20 %}
          </button>
        </form>
        <div data-predictive-search-results hidden></div>
      </cody-predictive-search>
    </div>
  </div>
</cody-drawer>
