{%- comment -%}
  CodyUI Fashion — Editorial Vector Icon System
  Usage: {% render 'cody-icons', icon: 'bag', size: 20, class: 'custom-class' %}
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 20
  assign icon_class = 'cody-icon cody-icon--' | append: icon
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}

<svg
  class="{{ icon_class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="var(--cody-icon-stroke, 1.4)"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'bag' -%}
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>

    {%- when 'heart' -%}
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>

    {%- when 'compare' -%}
      <polyline points="16 3 21 3 21 8"></polyline>
      <line x1="4" y1="20" x2="21" y2="3"></line>
      <polyline points="21 16 21 21 16 21"></polyline>
      <line x1="15" y1="15" x2="21" y2="21"></line>
      <line x1="4" y1="4" x2="9" y2="9"></line>

    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>

    {%- when 'user' -%}
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>

    {%- when 'menu' -%}
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="16" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>

    {%- when 'close' -%}
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>

    {%- when 'chevron-down' -%}
      <polyline points="6 9 12 15 18 9"></polyline>

    {%- when 'chevron-up' -%}
      <polyline points="18 15 12 9 6 15"></polyline>

    {%- when 'chevron-right' -%}
      <polyline points="9 18 15 12 9 6"></polyline>

    {%- when 'chevron-left' -%}
      <polyline points="15 18 9 12 15 6"></polyline>

    {%- when 'arrow-right' -%}
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>

    {%- when 'arrow-left' -%}
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>

    {%- when 'arrow-up-right' -%}
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>

    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>

    {%- when 'minus' -%}
      <line x1="5" y1="12" x2="19" y2="12"></line>

    {%- when 'eye' -%}
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
      <circle cx="12" cy="12" r="3"></circle>

    {%- when 'ruler' -%}
      <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path>
      <path d="m14.5 12.5 2-2"></path>
      <path d="m11.5 9.5 2-2"></path>
      <path d="m8.5 6.5 2-2"></path>
      <path d="m17.5 15.5 2-2"></path>

    {%- when 'truck' -%}
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>

    {%- when 'gift' -%}
      <polyline points="20 12 20 22 4 22 4 12"></polyline>
      <rect x="2" y="7" width="20" height="5"></rect>
      <line x1="12" y1="22" x2="12" y2="7"></line>
      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
      <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>

    {%- when 'check' -%}
      <polyline points="20 6 9 17 4 12"></polyline>

    {%- when 'filter' -%}
      <line x1="4" y1="21" x2="4" y2="14"></line>
      <line x1="4" y1="10" x2="4" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12" y2="3"></line>
      <line x1="20" y1="21" x2="20" y2="16"></line>
      <line x1="20" y1="12" x2="20" y2="3"></line>
      <line x1="1" y1="14" x2="7" y2="14"></line>
      <line x1="9" y1="8" x2="15" y2="8"></line>
      <line x1="17" y1="16" x2="23" y2="16"></line>

    {%- when 'star' -%}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="currentColor"></polygon>

    {%- when 'share' -%}
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>

    {%- when 'trash' -%}
      <polyline points="3 6 5 6 21 6"></polyline>
      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>

    {%- when 'play' -%}
      <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon>

    {%- when '3d-model' -%}
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
      <line x1="12" y1="22.08" x2="12" y2="12"></line>

    {%- when 'grid-2' -%}
      <rect x="3" y="3" width="7" height="18"></rect>
      <rect x="14" y="3" width="7" height="18"></rect>

    {%- when 'grid-3' -%}
      <rect x="2" y="3" width="5" height="18"></rect>
      <rect x="9.5" y="3" width="5" height="18"></rect>
      <rect x="17" y="3" width="5" height="18"></rect>

    {%- when 'grid-4' -%}
      <rect x="2" y="3" width="3.5" height="18"></rect>
      <rect x="7.5" y="3" width="3.5" height="18"></rect>
      <rect x="13" y="3" width="3.5" height="18"></rect>
      <rect x="18.5" y="3" width="3.5" height="18"></rect>

    {%- when 'shield' -%}
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>

    {%- when 'return' -%}
      <polyline points="1 4 1 10 7 10"></polyline>
      <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
  {%- endcase -%}
</svg>
