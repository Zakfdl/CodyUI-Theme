{%- comment -%}
  CodyUI Fashion — Editorial Breadcrumb Navigation + Schema.org BreadcrumbList JSON-LD
{%- endcomment -%}
{%- unless request.page_type == 'index' or request.page_type == 'cart' or request.page_type == 'list-collections' or request.page_type == '404' -%}
  {%- if settings.show_breadcrumbs -%}
    {%- assign t = request.page_type -%}
    <nav class="cody-breadcrumbs cody-container" role="navigation" aria-label="breadcrumbs">
      <ol class="cody-breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a class="cody-breadcrumbs__link" href="{{ routes.root_url }}" itemprop="item">
            <span itemprop="name">{{ 'general.breadcrumbs.home' | t }}</span>
          </a>
          <meta itemprop="position" content="1">
          <span class="cody-breadcrumbs__sep" aria-hidden="true">/</span>
        </li>

        {%- case t -%}
          {%- when 'page' -%}
            <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ page.title }}</span>
              <meta itemprop="position" content="2">
            </li>

          {%- when 'product' -%}
            {%- if collection.url -%}
              <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a class="cody-breadcrumbs__link" href="{{ collection.url }}" itemprop="item">
                  <span itemprop="name">{{ collection.title }}</span>
                </a>
                <meta itemprop="position" content="2">
                <span class="cody-breadcrumbs__sep" aria-hidden="true">/</span>
              </li>
              <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ product.title }}</span>
                <meta itemprop="position" content="3">
              </li>
            {%- else -%}
              <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ product.title }}</span>
                <meta itemprop="position" content="2">
              </li>
            {%- endif -%}

          {%- when 'collection' and collection.handle -%}
            {%- if current_tags -%}
              <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a class="cody-breadcrumbs__link" href="{{ collection.url }}" itemprop="item">
                  <span itemprop="name">{{ collection.title }}</span>
                </a>
                <meta itemprop="position" content="2">
                <span class="cody-breadcrumbs__sep" aria-hidden="true">/</span>
              </li>
              <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ current_tags | join: ' + ' }}</span>
                <meta itemprop="position" content="3">
              </li>
            {%- else -%}
              <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ collection.title }}</span>
                <meta itemprop="position" content="2">
              </li>
            {%- endif -%}

          {%- when 'blog' -%}
            <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ blog.title }}</span>
              <meta itemprop="position" content="2">
            </li>

          {%- when 'article' -%}
            <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a class="cody-breadcrumbs__link" href="{{ blog.url }}" itemprop="item">
                <span itemprop="name">{{ blog.title }}</span>
              </a>
              <meta itemprop="position" content="2">
              <span class="cody-breadcrumbs__sep" aria-hidden="true">/</span>
            </li>
            <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ article.title }}</span>
              <meta itemprop="position" content="3">
            </li>

          {%- else -%}
            <li class="cody-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="cody-breadcrumbs__current" aria-current="page" itemprop="name">{{ page_title }}</span>
              <meta itemprop="position" content="2">
            </li>
        {%- endcase -%}
      </ol>
    </nav>
  {%- endif -%}
{%- endunless -%}
