{%- comment -%}
  CodyUI Fashion — Brand Logo Snippet (Supports Primary + Transparent Header Logo)
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <h1 style="margin: 0;">
{%- endif -%}
  <a href="{{ routes.root_url }}" class="cody-header__logo-link">
    {%- if section.settings.logo != blank -%}
      {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
      {%- assign logo_height = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio -%}
      <img
        src="{{ section.settings.logo | image_url: width: 560 }}"
        alt="{{ logo_alt }}"
        width="{{ section.settings.logo_width }}"
        height="{{ logo_height | round }}"
        class="cody-header__logo-img"
        loading="eager"
      >
    {%- else -%}
      <span class="cody-header__logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
{%- if request.page_type == 'index' -%}
  </h1>
{%- endif -%}
